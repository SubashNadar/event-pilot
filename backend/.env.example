# Use azure for Azure OpenAI or openai for the public OpenAI API.
LLM_PROVIDER=azure
MODEL_DEPLOYMENT=

# Azure OpenAI: required only when agent execution is enabled.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
# The existing AZURE_OPENAI_CHAT_DEPLOYMENT name is also supported.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Optional Langfuse observability.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# PostgreSQL with the pgvector extension. Event briefs stay in SQLite for now;
# this database stores curated RAG document chunks and their embeddings.
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=
COLLECTION_NAME=eventpilot_knowledge
RAG_EMBEDDING_DIMENSIONS=1536
RAG_TOP_K=4
RAG_MIN_RELEVANCE_SCORE=0.55

# Planning runs (streaming steps, checkpoints and recovery).
MCP_URL=http://127.0.0.1:8000/mcp
DATA_DIR=data
MAX_PARALLEL_LLM_CALLS=3
MAX_STEP_ATTEMPTS=3
# Optional: Langfuse project id, for "Open in Langfuse" links in the step drawer.
LANGFUSE_PROJECT_ID=
# Demo switch: comma-separated MCP tools whose first call in each run fails,
# e.g. venue_search, to show the recovery card.
EVENTPILOT_FAIL_ONCE=
# MCP tools. Free web services, no keys: Open-Meteo (weather), OpenStreetMap
# Nominatim (geocoding) and the OSRM demo router (road times). Set to false to
# use only the bundled offline data (places, climate notes).
FREE_APIS_ENABLED=true
# Nominatim's usage policy asks for contact details in the User-Agent, e.g. an email.
HTTP_CONTACT=
HTTP_TIMEOUT_S=6
TOOL_TIMEOUT_S=25
MAX_TOOL_CALLS_PER_RUN=40
TOOL_CACHE_TTL_S=600
# Abuse protection: per-client limits on write requests; endpoints that call the
# LLM or start a plan run have their own per-minute and per-day budget.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WRITES_PER_MINUTE=60
RATE_LIMIT_LLM_PER_MINUTE=12
RATE_LIMIT_LLM_PER_DAY=300
# Only behind a trusted reverse proxy: take the client address from X-Forwarded-For.
TRUST_FORWARDED_FOR=false
MAX_BODY_BYTES=262144
MAX_CHAT_CHARS=1000
# Optional prices (USD per 1K tokens) for the usage line; 0 hides cost.
LLM_COST_PER_1K_INPUT=0
LLM_COST_PER_1K_OUTPUT=0
